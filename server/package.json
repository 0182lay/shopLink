{
    "name": "server",
    "version": "1.0.0",
    "packageManager": "yarn@1.22.22",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "tsx watch src/server.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:seed": "tsx prisma/seed.ts",
        "build": "tsc && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
        "render-build": "npm install --include=dev && npm run prisma:migrate:deploy && npm run prisma:generate && npm run build",
        "render-build:yarn": "yarn install --production=false && yarn prisma:migrate:deploy && yarn prisma:generate && yarn build",
        "start": "node dist/server.js"
    },
    "engines": {
        "node": ">=22"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.10.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.0",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "pg": "^8.21.0",
        "prisma": "^7.8.0",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.9.1",
        "@types/pg": "^8.20.0",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.22.3"
    }
}
